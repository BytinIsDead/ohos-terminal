// NOTE: DevEco Studio may normalize this file. Re-add the header if needed.

{
  "app": {
    "signingConfigs": [],
    "products": [
      {
        "name": "default",
        // HarmonyOS 6.1.1 — API 24 (DevEco Studio 6.1.1 Release).
        "compatibleSdkVersion": "6.1.1(24)",
        "targetSdkVersion": "6.1.1(24)",
        "runtimeOS": "HarmonyOS",
        "buildOption": {
          "strictMode": {
            "caseSensitiveCheck": true,
            // Keep classic OHM URLs: normalized mode has a known failure
            // mode resolving .so type packages to their index.d.ts.
            "useNormalizedOHMUrl": false
          }
        }
      }
    ],
    "buildModeSet": [
      {
        "name": "debug"
      },
      {
        "name": "release"
      }
    ]
  },
  "modules": [
    {
      "name": "entry",
      "srcPath": "./entry",
      "targets": [
        {
          "name": "default",
          "applyToProducts": [
            "default"
          ]
        }
      ]
    }
  ]
}
